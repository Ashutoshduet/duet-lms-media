#!/bin/sh
# keep each app's offline file list (sw.js, offline.json) in step with its files
top="$(git rev-parse --show-toplevel)"
# the classroom code is shared: science/js is the master copy, Human Body 360 gets a copy
for f in js/classroom.js js/classui.js js/tutor.js lib/peerjs.min.js; do
  if ! cmp -s "$top/science/$f" "$top/body/$f"; then cp "$top/science/$f" "$top/body/$f"; fi
  git add "body/$f"
done
# the teacher's class page: the list of activities it can send students to
node "$top/devtools/class/catalog.mjs" "$top" >/dev/null || exit 1
git add class/catalog.json
python3 "$top/devtools/offline/build_sw.py" "$top" science body drone space maths >/dev/null || exit 1
git add science/sw.js body/sw.js drone/sw.js space/sw.js maths/sw.js maths/index.html maths/voices.json science/offline.json body/offline.json drone/offline.json space/offline.json maths/offline.json
